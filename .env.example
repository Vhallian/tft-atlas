# Copia este archivo como .env.local y rellena con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API). Sin estas variables la web funciona solo en local.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Proveedores de inicio de sesión activados en Supabase (opcional): discord,google,github,twitch
VITE_SUPABASE_OAUTH=
